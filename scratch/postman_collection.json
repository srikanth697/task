{
  "info": {
    "name": "Doctor Portal API Collection",
    "description": "API collection to test Doctor Registration, Unified Login, and Super Admin Approval/Rejection panel flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication & Frontend",
      "item": [
        {
          "name": "Doctor Registration",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "fullName",
                  "value": "John Doe",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "johndoe@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "DoctorPass123!",
                  "type": "text"
                },
                {
                  "key": "mobileNumber",
                  "value": "+1234567890",
                  "type": "text"
                },
                {
                  "key": "gender",
                  "value": "male",
                  "type": "text"
                },
                {
                  "key": "experience",
                  "value": "8",
                  "type": "text"
                },
                {
                  "key": "specialization",
                  "value": "Cardiology",
                  "type": "text"
                },
                {
                  "key": "licenseNumber",
                  "value": "LIC-CARD-9912",
                  "type": "text"
                },
                {
                  "key": "documents",
                  "description": "Select PDF or image files to upload",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Doctor Login (Before Approval - Fails)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"DoctorPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseJson = pm.response.json();",
                  "if (responseJson.token) {",
                  "    pm.environment.set(\"admin_token\", responseJson.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@task.com\",\n  \"password\": \"adminpassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Panel Operations",
      "item": [
        {
          "name": "Get Pending Doctors List",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/pending?page=1&limit=10&search=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "pending"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Doctor Details",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/doctors/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "doctors",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "doctor_id_here",
                  "description": "Insert the ID of the registered doctor"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Approve Doctor Application",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/approve/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "approve",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "doctor_id_here",
                  "description": "Insert the ID of the registered doctor"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reject Doctor Application",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Provided medical license copy has expired or is invalid.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/reject/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "reject",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "doctor_id_here",
                  "description": "Insert the ID of the registered doctor"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Doctor Login (After Approval - Succeeds)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"DoctorPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          ""
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          ""
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ]
}
